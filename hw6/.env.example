# Copy this file to .env and fill in your own key. Variable names only here — never values.
# .env is gitignored and is never committed.
#
#   cp .env.example .env
#
# PORTKEY_API_KEY is the only one you need to set. The others are optional overrides.
#
# OPENAI_MODEL is read but CANNOT change the model. This project is pinned to gpt-6-luna in
# app_config.REQUIRED_OPENAI_MODEL; any other value is ignored and reported on
# Settings.model_override_ignored.

PORTKEY_API_KEY=
OPENAI_MODEL=
PORTKEY_BASE_URL=
PORTKEY_PROVIDER=
PORTKEY_CONFIG_ID=
